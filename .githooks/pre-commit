#!/usr/bin/env bash
# Runs only the gates the staged paths can affect (scripts/check_scopes.py).
# Set CAIRN_FULL_CHECK=1 to run every gate.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"

git diff --cached --check
python3 -m unittest discover -s scripts -p 'test_*.py' >/dev/null 2>&1 \
  || python3 -m unittest discover -s scripts -p 'test_*.py'

if [ "${CAIRN_FULL_CHECK:-0}" = 1 ]; then
  scopes="$(python3 scripts/check_scopes.py --all)"
else
  scopes="$(python3 scripts/check_scopes.py --staged)"
fi
# Git exports GIT_DIR/GIT_INDEX_FILE to hooks; fixture repositories in the
# gates must not inherit them.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
echo "pre-commit gates: ${scopes:-none}" >&2

case " $scopes " in
  *" models "*) scripts/check.sh ;;
  *" workflows "*)
    if command -v actionlint >/dev/null; then
      actionlint .github/workflows/*.yml
    else
      echo "skip: actionlint not installed" >&2
    fi
    ;;
esac
case " $scopes " in
  *" rust "*) bash scripts/check-rust.sh ;;
esac
