<?xml version="1.0" encoding="utf-8"?>
<!-- ADR 0006: the sealed database stays on this device; its Keystore key could not follow it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
