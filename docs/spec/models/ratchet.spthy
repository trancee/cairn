theory CairnRatchet
begin

/*
 * cairn-r1 sections 6/9: quantum-view Resume composed with the alternating PQ ratchet.
 * X25519 is deliberately public here. Pairing provides a secret CK_0; pairID is public.
 * ML-KEM is ideal, with explicit decapsulation and implicit rejection. HKDF/MAC are free functions.
 *
 * Positive natural numbers encode wire epoch e as e+1, covering finite prefixes before u32 exhaustion,
 * not the arithmetic/encoding boundary. Two abstract contiguous pieces cover each EK/CT object.
 * Pieces represent complementary byte ranges. Each reveals the full public EK/CT object to the
 * attacker (a conservative disclosure abstraction), but acceptance still requires both pieces.
 * Concrete offsets, lengths and persistence need implementation tests. Prefix facts are storage.
 * Progress follows storage and second pieces require authenticated progress. Full receipts require
 * a sent tail. Stored objects, receipts and DONE can be retransmitted under a new session.
 * Exact duplicate pieces are harmless; guards select the latest stored progress.
 *
 * Persistent CK candidates carry epoch position and next generator. Index records the locally
 * committed position. A timed-out responder retains its old Index and both candidate positions.
 * Recovery on the new candidate does not mix the previous epoch twice.
 *
 * Restrictions implement the specified atomic current-state, immutable-prefix, single-epoch and
 * mandatory-MIX guards. They are implementation obligations, not cryptographic assumptions.
 * The attacker may reveal every available CK, in-flight DK and pending epoch secret. Stolen values
 * remain known forever. Healing requires an honestly generated EK and honest encapsulation whose
 * fresh epoch secrets are not revealed; continued active replacement can prevent recovery.
 */

builtins: hashing, symmetric-encryption, natural-numbers
functions: kdf/3, ext/2, mac/2, kem/2, kdec/2, pk/1, roleA/0, roleB/0, flip/1
equations: kdec(kem(ss, pk(dk)), dk) = ss, flip(roleA) = roleB, flip(roleB) = roleA

#include "ratchet-tactics.inc"

restriction distinct: "All a b #i. Neq(a,b)@i ==> not (a=b)"
restriction current_ck: "All pid r ck #i #j. Cur(pid,r,ck)@i & Retire(pid,r,ck)@j ==> #i < #j | #i = #j"
restriction retire_once:
  "All pid r ck #i #j. Retire(pid,r,ck)@i & Retire(pid,r,ck)@j
     & not (ck='none') ==> #i = #j"
restriction valid_collision_mode:
  "All mode #i. CollisionMode(mode)@i ==> mode='0' | mode='1'"
restriction current_epoch: "All pid r %e n #i #j. EUse(pid,r,%e)@i & Advance(pid,r,%e,n)@j ==> #i < #j | #i = #j"
restriction advance_once: "All pid r %e n m #i #j. Advance(pid,r,%e,n)@i & Advance(pid,r,%e,m)@j ==> #i = #j"
restriction once: "All pid r %e kind #i #j. Once(pid,r,%e,kind)@i & Once(pid,r,%e,kind)@j ==> #i = #j"
restriction ek_prefix: "All pid r %e x y #i #j. EKPrefix(pid,r,%e,x)@i & EKPrefix(pid,r,%e,y)@j ==> x=y"
restriction ct_prefix: "All pid r %e x y #i #j. CTPrefix(pid,r,%e,x)@i & CTPrefix(pid,r,%e,y)@j ==> x=y"
restriction latest_progress:
  "All pid r %e kind #i #j. ProgressSent(pid,r,%e,kind,'half')@i
     & Durable(pid,r,%e,kind,'full')@j ==> #i < #j | #i = #j"
restriction completed_send:
  "All pid r %e kind pos #i #j. Sent(pid,r,%e,kind,pos)@i
     & Ack(pid,r,%e,kind,'full')@j ==> #i < #j | #i = #j"
restriction prefix_send:
  "All pid r %e kind #i #j. Sent(pid,r,%e,kind,'half')@i
     & Ack(pid,r,%e,kind,'half')@j ==> #i < #j | #i = #j"
#ifdef CLASSIC_FALLBACK
/* Mutation: the mandatory-MIX guard is removed. */
#else
restriction mandatory_mix:
  "All pid r %e #i #j. ClassicStart(pid,r,%e)@i & Ready(pid,r,%e)@j ==>
     #i < #j | #i = #j"
#endif

/* Positive-trace profiles prune irrelevant branches; security lemmas run without EXECUTION. */
#ifdef EXECUTION
restriction execution_pair:
  "All pid ck q key #i #j. Init(pid,ck)@i & Init(q,key)@j ==> #i = #j"
restriction execution_once:
  "All pid r name %s #i #j. TraceStep(pid,r,name,%s)@i & TraceStep(pid,r,name,%s)@j ==> #i = #j"
restriction execution_stages:
  "All pid r name %s #i. TraceStep(pid,r,name,%s)@i ==>
     %s=%1 | %s=(%1 %+ %1) | %s=(%1 %+ %1 %+ %1)
     | %s=(%1 %+ %1 %+ %1 %+ %1) | %s=(%1 %+ %1 %+ %1 %+ %1 %+ %1)
     | %s=(%1 %+ %1 %+ %1 %+ %1 %+ %1 %+ %1)
     | %s=(%1 %+ %1 %+ %1 %+ %1 %+ %1 %+ %1 %+ %1)"
restriction execution_roles:
  "All pid r name %s #i. TraceStep(pid,r,name,%s)@i ==>
     ((name='I_S1_classic' | name='I_S1_mix' | name='I_S2_classic' | name='I_S2_mix') ==> r=roleA)
     & ((name='R_S2_classic' | name='R_S2_mix' | name='R_Data_same_epoch'
       | name='R_Data_advance_epoch' | name='R_Data_recovery_candidate' | name='R_Timeout'
       | name='Prepare_encapsulation' | name='Receive_EK_prefix' | name='Receive_EK_tail'
       | name='Encapsulate' | name='Send_CT_tail' | name='Receive_progress_CT') ==> r=roleB)
     & ((name='Prepare_DK' | name='Generate_EK' | name='Send_EK_tail'
       | name='Receive_progress_EK' | name='Receive_CT_prefix' | name='Receive_CT_tail') ==> r=roleA)"
restriction execution_rules:
  "All pid r name %s #i. TraceStep(pid,r,name,%s)@i ==>
     name='Pair' | name='Prepare_DK' | name='Prepare_encapsulation' | name='Reveal_CK'
     | name='Acquire_Resume' | name='Release_Resume'
     | name='I_S1_classic' | name='I_S1_mix' | name='R_S2_classic' | name='R_S2_mix'
     | name='I_S2_classic' | name='I_S2_mix' | name='R_Data_same_epoch'
     | name='R_Data_advance_epoch' | name='R_Data_recovery_candidate' | name='R_Timeout'
     | name='Generate_EK' | name='Send_EK_tail' | name='Receive_EK_prefix'
     | name='Receive_EK_tail' | name='Encapsulate' | name='Send_CT_tail'
     | name='Receive_CT_prefix' | name='Receive_CT_tail'
     | name='Receive_progress_EK' | name='Receive_progress_CT'"
restriction execution_schedule:
  "All pid r name %s #i. TraceStep(pid,r,name,%s)@i ==>
     (name='Pair' & %s=%1) | (name='Prepare_DK' & %s=%1)
     | (name='Prepare_encapsulation' & %s=%1) | (name='Reveal_CK' & %s=%1)
     | (name='Acquire_Resume' & (%s=%1 | %s=(%1 %+ %1 %+ %1) | %s=(%1 %+ %1 %+ %1 %+ %1 %+ %1)))
     | (name='Release_Resume' & (%s=(%1 %+ %1 %+ %1) | %s=(%1 %+ %1 %+ %1 %+ %1 %+ %1)
       | %s=(%1 %+ %1 %+ %1 %+ %1 %+ %1 %+ %1 %+ %1)))
     | ((name='I_S1_classic' | name='R_S2_classic' | name='I_S2_classic'
       | name='R_Data_same_epoch') & (%s=(%1 %+ %1) | %s=(%1 %+ %1 %+ %1 %+ %1 %+ %1 %+ %1)))
     | ((name='I_S1_mix' | name='R_S2_mix' | name='I_S2_mix'
       | name='R_Data_advance_epoch' | name='R_Timeout') & %s=(%1 %+ %1 %+ %1 %+ %1))
     | (name='R_Data_recovery_candidate' & %s=(%1 %+ %1 %+ %1 %+ %1 %+ %1 %+ %1))
     | ((name='Generate_EK' | name='Send_EK_tail' | name='Receive_EK_prefix'
       | name='Receive_EK_tail' | name='Encapsulate' | name='Send_CT_tail'
       | name='Receive_CT_prefix' | name='Receive_CT_tail'
       | name='Receive_progress_EK' | name='Receive_progress_CT') & %s=%1)"
#endif

#ifdef EXECUTION_NONRECOVERY
restriction execution_no_late_classic:
  "All pid r name %s #i. TraceStep(pid,r,name,%s)@i ==>
     not ((name='I_S1_classic' | name='R_S2_classic' | name='I_S2_classic'
       | name='R_Data_same_epoch') & %s=(%1 %+ %1 %+ %1 %+ %1 %+ %1 %+ %1))"
restriction execution_resume_schedule:
  "All pid r name %s #i. TraceStep(pid,r,name,%s)@i ==>
     (name='Acquire_Resume' ==> (%s=%1 | %s=(%1 %+ %1 %+ %1)))
     & (name='Release_Resume' ==> (%s=(%1 %+ %1 %+ %1) | %s=(%1 %+ %1 %+ %1 %+ %1 %+ %1)))"
#endif

rule Pair:
  [ Fr(~pid), Fr(~ck) ]
--[ TraceStep(~pid,'contact_setup','Pair',%1),  Init(~pid,~ck), CK(~pid,~ck), Position(~pid,%1,roleA), Neq($A,$B),
    Candidates(~pid,roleA,~ck,~ck), Candidates(~pid,roleB,~ck,~ck),
    LockStage(~pid,roleA,%1), LockStage(~pid,roleB,%1) ]->
  [ !Party(~pid,roleA,roleB), !Party(~pid,roleB,roleA),
    ResumeSlot(~pid,roleA,%1), ResumeSlot(~pid,roleB,%1),
    CandidateState(~pid,roleA,~ck,'none'), CandidateState(~pid,roleB,~ck,'none'),
    !CKValue(~pid,~ck), !PositionValue(~pid,%1,roleA),
    !St(~pid,roleA,~ck,%1,roleA), !St(~pid,roleB,~ck,%1,roleA),
    !Index(~pid,roleA,%1,roleA), !Index(~pid,roleB,%1,roleA),
    Out(~pid) ]

/* Execution builds omit compromise rules unless explicitly testing CK healing. */
#ifdef EXECUTION
#else
rule Reveal_CK:
  [ !CKValue(pid,ck)[no_precomp], !St(pid,r,ck,%e,g)[-,no_precomp] ]
--[ TraceStep(pid,r,'Reveal_CK',%1),  Cur(pid,r,ck), EUse(pid,r,%e), RevCK(pid), RevCKv(pid,ck) ]-> [ Out(ck) ]

rule Reveal_DK:
  [ !DKOwner(pid,~dk)[no_precomp], !GenKey(pid,r,%e,~dk)[-,no_precomp] ]
--[ TraceStep(pid,r,'Reveal_DK',%1),  EUse(pid,r,%e), RevDK(pid,pk(~dk)) ]-> [ Out(~dk) ]

rule Reveal_SS:
  [ !SSValue(pid,ss)[no_precomp], !Have(pid,r,%e,pq,ss,ek,ct)[-,no_precomp] ]
--[ TraceStep(pid,r,'Reveal_SS',%1),  EUse(pid,r,%e), RevSS(pid,ss) ]-> [ Out(ss) ]
#endif

#ifdef COMPROMISE_EXECUTION
rule Reveal_CK_execution:
  [ !CKValue(pid,ck)[no_precomp], !St(pid,r,ck,%e,g)[-,no_precomp] ]
--[ TraceStep(pid,r,'Reveal_CK',%1),  Cur(pid,r,ck), EUse(pid,r,%e), RevCK(pid), RevCKv(pid,ck) ]-> [ Out(ck) ]
#endif

/* Linear material separates fresh randomness from the session that consumes it. */
rule Prepare_DK:
  [ !Party(pid,r,p)[no_precomp], Fr(~dk) ]
--[ TraceStep(pid,r,'Prepare_DK',%1),  FreshDK(pid,~dk) ]-> [ !DKOwner(pid,~dk), DKMaterial(pid,r,~dk), Out(pk(~dk)) ]

rule Prepare_encapsulation:
  let ct = kem(~ss,ek)
  in
  [ !Party(pid,r,p)[no_precomp], In(ek), Fr(~ss) ]
--[ TraceStep(pid,r,'Prepare_encapsulation',%1),  FreshSS(pid,~ss,ek) ]->
  [ EncMaterial(pid,r,ek,ct,~ss), !SSValue(pid,~ss), Out(ct) ]

/* A ghost result table; disclosure still requires the actual active Have state. */
rule Decode_known_ciphertext:
  [ !DKOwner(pid,~dk)[no_precomp], In(ct) ]
--[ TraceStep(pid,'ghost','Decode_known_ciphertext',%1) ]-> [ !SSValue(pid,kdec(ct,~dk)) ]

#include "ratchet-resume.inc"

/* Each object is split into two complementary abstract contiguous byte ranges. */
rule Generate_EK:
  [ !Index(pid,r,%e,r)[-,no_precomp],     !Session(pid,r,ck,%e,r,ks,kr)[-,no_precomp], !SKValue(pid,r,ks,kr)[no_precomp], DKMaterial(pid,r,~dk), !CKValue(pid,ck)[no_precomp],
    !PositionValue(pid,%e,r)[no_precomp] ]
--[ TraceStep(pid,r,'Generate_EK',%1),  SessionUse(pid,r,ks,kr), Cur(pid,r,ck), EUse(pid,r,%e), Once(pid,r,%e,'gen'), EpGen(pid,r,%e,pk(~dk)),
    LocalComplete(pid,r,%e,'EK'), Sent(pid,r,%e,'EK','half'), EncryptedOutput(<'EK',%e,'prefix',pk(~dk)>,ks) ]->
  [ !GenKey(pid,r,%e,~dk), Out(senc(<'EK',%e,'prefix',pk(~dk)>,ks)) ]

rule Send_EK_tail:
  [ !GenKey(pid,r,%e,~dk)[no_precomp], !Progress(pid,r,%e,'EK','half')[no_precomp],
    !Session(pid,r,ck,%e,g,ks,kr)[no_precomp], !SKValue(pid,r,ks,kr)[no_precomp], !CKValue(pid,ck)[no_precomp] ]
--[ TraceStep(pid,r,'Send_EK_tail',%1),  SessionUse(pid,r,ks,kr), Cur(pid,r,ck), EUse(pid,r,%e), Sent(pid,r,%e,'EK','full'), EncryptedOutput(<'EK',%e,'half',pk(~dk)>,ks) ]->
  [ !SentTail(pid,r,%e,'EK'), Out(senc(<'EK',%e,'half',pk(~dk)>,ks)) ]

rule Receive_EK_prefix:
  [ !Party(pid,r,p)[no_precomp], !Index(pid,r,%e,p)[no_precomp], !Session(pid,r,ck,%e,p,ks,kr)[no_precomp], !SKValue(pid,r,ks,kr)[no_precomp],
    In(senc(<'EK',%e,'prefix',ek>,kr)), !CKValue(pid,ck)[no_precomp] ]
--[ TraceStep(pid,r,'Receive_EK_prefix',%1),  SessionUse(pid,r,ks,kr), Cur(pid,r,ck), EUse(pid,r,%e), EKPrefix(pid,r,%e,ek), Durable(pid,r,%e,'EK','half'),
    ProgressSent(pid,r,%e,'EK','half'), EncryptedOutput(<'PROGRESS',%e,'EK','half'>,ks) ]->
  [ !EK0(pid,r,%e,ek), Out(senc(<'PROGRESS',%e,'EK','half'>,ks)) ]

rule Receive_EK_tail:
  [ !EK0(pid,r,%e,ek), !Session(pid,r,ck,%e,g,ks,kr)[no_precomp], !SKValue(pid,r,ks,kr)[no_precomp], In(senc(<'EK',%e,'half',ek>,kr)), !CKValue(pid,ck)[no_precomp] ]
--[ TraceStep(pid,r,'Receive_EK_tail',%1),  SessionUse(pid,r,ks,kr), Cur(pid,r,ck), EUse(pid,r,%e), ReceivedFull(pid,r,%e,'EK'),
    LocalComplete(pid,r,%e,'EK'), Durable(pid,r,%e,'EK','full'),
    ProgressSent(pid,r,%e,'EK','full'), EncryptedOutput(<'PROGRESS',%e,'EK','full'>,ks) ]->
  [ !CompleteEK(pid,r,%e,ek), Out(senc(<'PROGRESS',%e,'EK','full'>,ks)) ]

#ifdef NO_PREFIX_GUARD
rule Receive_EK_tail_unguarded:
  [ !Session(pid,r,ck,%e,g,ks,kr)[no_precomp], !SKValue(pid,r,ks,kr)[no_precomp], In(senc(<'EK',%e,'half',ek>,kr)), !CKValue(pid,ck)[no_precomp] ]
--[ TraceStep(pid,r,'Receive_EK_tail_unguarded',%1),  SessionUse(pid,r,ks,kr), Cur(pid,r,ck), EUse(pid,r,%e), ReceivedFull(pid,r,%e,'EK'),
    LocalComplete(pid,r,%e,'EK'), Durable(pid,r,%e,'EK','full'),
    ProgressSent(pid,r,%e,'EK','full'), EncryptedOutput(<'PROGRESS',%e,'EK','full'>,ks) ]->
  [ !CompleteEK(pid,r,%e,ek), Out(senc(<'PROGRESS',%e,'EK','full'>,ks)) ]
#endif

rule Encapsulate:
  let pq = <ss,h(ek),h(ct)>
  in
  [ !CompleteEK(pid,r,%e,ek)[-,no_precomp],     !Session(pid,r,ck,%e,g,ks,kr)[-,no_precomp], !SKValue(pid,r,ks,kr)[no_precomp], EncMaterial(pid,r,ek,ct,ss), !CKValue(pid,ck)[no_precomp] ]
--[ TraceStep(pid,r,'Encapsulate',%1),  SessionUse(pid,r,ks,kr), Cur(pid,r,ck), EUse(pid,r,%e), Once(pid,r,%e,'enc'), EpEnc(pid,r,%e,ek,ct,ss),
    EpochHave(pid,r,%e,pq), LocalComplete(pid,r,%e,'CT'), Sent(pid,r,%e,'CT','half'), EncryptedOutput(<'CT',%e,'prefix',ct>,ks) ]->
  [ !Have(pid,r,%e,pq,ss,ek,ct), !EncWait(pid,r,%e,ct,pq),
    Out(senc(<'CT',%e,'prefix',ct>,ks)) ]

rule Send_CT_tail:
  [ !EncWait(pid,r,%e,ct,pq)[no_precomp], !Progress(pid,r,%e,'CT','half')[no_precomp],
    !Session(pid,r,ck,%e,g,ks,kr)[no_precomp], !SKValue(pid,r,ks,kr)[no_precomp], !CKValue(pid,ck)[no_precomp] ]
--[ TraceStep(pid,r,'Send_CT_tail',%1),  SessionUse(pid,r,ks,kr), Cur(pid,r,ck), EUse(pid,r,%e), Sent(pid,r,%e,'CT','full'), EncryptedOutput(<'CT',%e,'half',ct>,ks) ]->
  [ !SentTail(pid,r,%e,'CT'), Out(senc(<'CT',%e,'half',ct>,ks)) ]

rule Receive_CT_prefix:
  [ !GenKey(pid,r,%e,~dk)[no_precomp], !Session(pid,r,ck,%e,g,ks,kr)[no_precomp], !SKValue(pid,r,ks,kr)[no_precomp], In(senc(<'CT',%e,'prefix',ct>,kr)), !CKValue(pid,ck)[no_precomp] ]
--[ TraceStep(pid,r,'Receive_CT_prefix',%1),  SessionUse(pid,r,ks,kr), Cur(pid,r,ck), EUse(pid,r,%e), CTPrefix(pid,r,%e,ct), Durable(pid,r,%e,'CT','half'),
    ProgressSent(pid,r,%e,'CT','half'), EncryptedOutput(<'PROGRESS',%e,'CT','half'>,ks) ]->
  [ !CT0(pid,r,%e,ct), Out(senc(<'PROGRESS',%e,'CT','half'>,ks)) ]

rule Receive_CT_tail:
  let ss = kdec(ct,~dk)
      pq = <ss,h(pk(~dk)),h(ct)>
  in
  [ !GenKey(pid,r,%e,~dk)[no_precomp], !CT0(pid,r,%e,ct), !Session(pid,r,ck,%e,g,ks,kr)[no_precomp], !SKValue(pid,r,ks,kr)[no_precomp],
    In(senc(<'CT',%e,'half',ct>,kr)), !CKValue(pid,ck)[no_precomp] ]
--[ TraceStep(pid,r,'Receive_CT_tail',%1),  SessionUse(pid,r,ks,kr), Cur(pid,r,ck), EUse(pid,r,%e), ReceivedFull(pid,r,%e,'CT'), LocalComplete(pid,r,%e,'CT'),
    Durable(pid,r,%e,'CT','full'), EpDec(pid,r,%e,pk(~dk),ct,ss),
    EpochHave(pid,r,%e,pq), Ready(pid,r,%e), ProgressSent(pid,r,%e,'CT','full'), EncryptedOutput(<'PROGRESS',%e,'CT','full'>,ks), EncryptedOutput(<'DONE',%e>,ks) ]->
  [ !Have(pid,r,%e,pq,ss,pk(~dk),ct), !ReadyEpoch(pid,r,%e,pq), !CompleteCT(pid,r,%e,ct),
    Out(senc(<'PROGRESS',%e,'CT','full'>,ks)), Out(senc(<'DONE',%e>,ks)) ]

#ifdef NO_PREFIX_GUARD
rule Receive_CT_tail_unguarded:
  let ss = kdec(ct,~dk)
      pq = <ss,h(pk(~dk)),h(ct)>
  in
  [ !GenKey(pid,r,%e,~dk)[no_precomp], !Session(pid,r,ck,%e,g,ks,kr)[no_precomp], !SKValue(pid,r,ks,kr)[no_precomp],
    In(senc(<'CT',%e,'half',ct>,kr)), !CKValue(pid,ck)[no_precomp] ]
--[ TraceStep(pid,r,'Receive_CT_tail_unguarded',%1),  SessionUse(pid,r,ks,kr), Cur(pid,r,ck), EUse(pid,r,%e), ReceivedFull(pid,r,%e,'CT'), LocalComplete(pid,r,%e,'CT'),
    Durable(pid,r,%e,'CT','full'), EpDec(pid,r,%e,pk(~dk),ct,ss),
    EpochHave(pid,r,%e,pq), Ready(pid,r,%e), ProgressSent(pid,r,%e,'CT','full'), EncryptedOutput(<'PROGRESS',%e,'CT','full'>,ks), EncryptedOutput(<'DONE',%e>,ks) ]->
  [ !Have(pid,r,%e,pq,ss,pk(~dk),ct), !ReadyEpoch(pid,r,%e,pq), !CompleteCT(pid,r,%e,ct),
    Out(senc(<'PROGRESS',%e,'CT','full'>,ks)), Out(senc(<'DONE',%e>,ks)) ]
#endif

rule Receive_DONE:
  [ !EncWait(pid,r,%e,ct,pq)[no_precomp], !Session(pid,r,ck,%e,g,ks,kr)[no_precomp], !SKValue(pid,r,ks,kr)[no_precomp], In(senc(<'DONE',%e>,kr)), !CKValue(pid,ck)[no_precomp] ]
--[ TraceStep(pid,r,'Receive_DONE',%1),  SessionUse(pid,r,ks,kr), Cur(pid,r,ck), EUse(pid,r,%e), Ready(pid,r,%e) ]-> [ !ReadyEpoch(pid,r,%e,pq) ]

rule Receive_progress_EK:
  [ !GenKey(pid,r,%e,~dk)[no_precomp], !Session(pid,r,ck,%e,g,ks,kr)[no_precomp], !SKValue(pid,r,ks,kr)[no_precomp],
    In(senc(<'PROGRESS',%e,'EK','half'>,kr)), !CKValue(pid,ck)[no_precomp] ]
--[ TraceStep(pid,r,'Receive_progress_EK',%1),  SessionUse(pid,r,ks,kr), Cur(pid,r,ck), EUse(pid,r,%e), Ack(pid,r,%e,'EK','half') ]-> [ !Progress(pid,r,%e,'EK','half') ]

rule Receive_progress_CT:
  [ !EncWait(pid,r,%e,ct,pq)[no_precomp], !Session(pid,r,ck,%e,g,ks,kr)[no_precomp], !SKValue(pid,r,ks,kr)[no_precomp],
    In(senc(<'PROGRESS',%e,'CT','half'>,kr)), !CKValue(pid,ck)[no_precomp] ]
--[ TraceStep(pid,r,'Receive_progress_CT',%1),  SessionUse(pid,r,ks,kr), Cur(pid,r,ck), EUse(pid,r,%e), Ack(pid,r,%e,'CT','half') ]-> [ !Progress(pid,r,%e,'CT','half') ]

rule Receive_progress_full:
  [ !SentTail(pid,r,%e,kind)[no_precomp], !Session(pid,r,ck,%e,g,ks,kr)[no_precomp], !SKValue(pid,r,ks,kr)[no_precomp],
    In(senc(<'PROGRESS',%e,kind,'full'>,kr)), !CKValue(pid,ck)[no_precomp] ]
--[ TraceStep(pid,r,'Receive_progress_full',%1),  SessionUse(pid,r,ks,kr), Cur(pid,r,ck), EUse(pid,r,%e), Ack(pid,r,%e,kind,'full') ]->
  [ !Progress(pid,r,%e,kind,'full') ]

rule Resend_EK_prefix:
  [ !GenKey(pid,r,%e,~dk)[no_precomp], !Session(pid,r,ck,%e,g,ks,kr)[no_precomp], !SKValue(pid,r,ks,kr)[no_precomp], !CKValue(pid,ck)[no_precomp] ]
--[ TraceStep(pid,r,'Resend_EK_prefix',%1),  SessionUse(pid,r,ks,kr), Cur(pid,r,ck), EUse(pid,r,%e), Sent(pid,r,%e,'EK','half'), EncryptedOutput(<'EK',%e,'prefix',pk(~dk)>,ks) ]->
  [ Out(senc(<'EK',%e,'prefix',pk(~dk)>,ks)) ]

rule Resend_CT_prefix:
  [ !EncWait(pid,r,%e,ct,pq)[no_precomp], !Session(pid,r,ck,%e,g,ks,kr)[no_precomp], !SKValue(pid,r,ks,kr)[no_precomp], !CKValue(pid,ck)[no_precomp] ]
--[ TraceStep(pid,r,'Resend_CT_prefix',%1),  SessionUse(pid,r,ks,kr), Cur(pid,r,ck), EUse(pid,r,%e), Sent(pid,r,%e,'CT','half'), EncryptedOutput(<'CT',%e,'prefix',ct>,ks) ]->
  [ Out(senc(<'CT',%e,'prefix',ct>,ks)) ]

