(version 1)
(deny default)
(allow process-exec)
(allow process-fork)
(allow sysctl-read)
(allow file-read-metadata)
(allow file-read*
  (literal "/")
  (subpath "/System")
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/Library/Developer")
  (subpath "/Library/Java")
  (subpath "/Library/Apple")
  (regex #"^/Applications/Xcode[^/]*\.app(/|$)")
  (subpath "/opt/cairn-apple-tools")
  (subpath (param "INPUTS"))
  (subpath (param "SCRATCH"))
  (literal "/dev/null")
  (literal "/dev/random")
  (literal "/dev/urandom"))
(allow file-read* (literal "/private/etc/ssl/openssl.cnf"))
(allow file-write* (subpath (param "SCRATCH")) (literal "/dev/null"))
(if (equal? (param "PRIVATE_IPC") "true")
  (begin
    (allow network-bind
      (local udp "*:*")
      (local tcp "localhost:*"))
    (allow network-inbound
      (remote tcp "localhost:*")
      (remote udp "localhost:*"))
    (allow network-outbound
      (remote tcp "localhost:*")
      (remote udp "localhost:*"))))
