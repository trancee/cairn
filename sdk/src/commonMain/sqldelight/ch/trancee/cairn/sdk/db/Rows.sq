-- Sealed core rows (ADR 0035 §3). Each blob is a RowSealer output bound to its slot and version.
-- Ids are unsigned in the core and stored as their two's-complement Long, so Kotlin sorts them.

CREATE TABLE device (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    version INTEGER NOT NULL,
    ciphertext BLOB NOT NULL
);

CREATE TABLE contact (
    id INTEGER NOT NULL PRIMARY KEY,
    version INTEGER NOT NULL,
    ciphertext BLOB NOT NULL
);

CREATE TABLE queued (
    contact INTEGER NOT NULL,
    msgno INTEGER NOT NULL,
    version INTEGER NOT NULL,
    ciphertext BLOB NOT NULL,
    PRIMARY KEY (contact, msgno)
);

-- Carried envelopes and tombstones, keyed by the core's slot (ADR 0036 §3).
CREATE TABLE courier (
    slot INTEGER NOT NULL PRIMARY KEY,
    version INTEGER NOT NULL,
    ciphertext BLOB NOT NULL
);

putDevice:
INSERT OR REPLACE INTO device (id, version, ciphertext) VALUES (0, ?, ?);

putContact:
INSERT OR REPLACE INTO contact (id, version, ciphertext) VALUES (?, ?, ?);

putQueued:
INSERT OR REPLACE INTO queued (contact, msgno, version, ciphertext) VALUES (?, ?, ?, ?);

deleteQueued:
DELETE FROM queued WHERE contact = ? AND msgno = ?;

putCourier:
INSERT OR REPLACE INTO courier (slot, version, ciphertext) VALUES (?, ?, ?);

deleteCourier:
DELETE FROM courier WHERE slot = ?;

device:
SELECT version, ciphertext FROM device;

contacts:
SELECT id, version, ciphertext FROM contact;

queuedRows:
SELECT contact, msgno, version, ciphertext FROM queued;

courierRows:
SELECT slot, version, ciphertext FROM courier;

wipeDevice:
DELETE FROM device;

wipeContacts:
DELETE FROM contact;

wipeQueued:
DELETE FROM queued;

wipeCourier:
DELETE FROM courier;
